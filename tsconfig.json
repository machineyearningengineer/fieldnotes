{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "packages/**/*.ts",
    "apps/api/**/*.ts",
    "apps/worker/**/*.ts",
    "scenarios/**/*.ts",
    "scripts/**/*.ts"
  ]
}
